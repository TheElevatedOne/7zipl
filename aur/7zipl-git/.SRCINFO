	depends = gtk4
	depends = pango
	depends = cairo
	optdepends = xdg-utils: open files from archives with their application
	provides = 7zipl
	conflicts = 7zipl
	source = 7zipl::git+https://github.com/TheElevatedOne/7zipl.git
	sha256sums = SKIP

pkgname = 7zipl-git
