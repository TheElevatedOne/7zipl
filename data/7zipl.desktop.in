[Desktop Entry]
Type=Application
Name=7zipl
GenericName=Archive Manager
Comment=Browse, create and extract 7z, zip, tar, rar and other archives
Exec=7zipl %f
Icon=@SZL_APP_ID@
Terminal=false
StartupNotify=true
StartupWMClass=7zipl
Categories=GTK;Utility;Archiving;Compression;
Keywords=7z;7-Zip;zip;rar;tar;iso;archive;extract;compress;unpack;
MimeType=application/x-7z-compressed;application/zip;application/x-zip-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-tar;application/gzip;application/x-gzip;application/x-compressed-tar;application/x-bzip2;application/x-bzip;application/x-bzip2-compressed-tar;application/x-bzip-compressed-tar;application/x-xz;application/x-xz-compressed-tar;application/x-lzma;application/x-lzma-compressed-tar;application/zstd;application/x-zstd;application/x-zstd-compressed-tar;application/x-compress;application/x-tarz;application/vnd.efi.iso;application/x-cd-image;application/x-iso9660-image;application/x-ms-wim;application/vnd.ms-cab-compressed;application/x-rpm;application/x-source-rpm;application/vnd.debian.binary-package;application/x-deb;application/x-cpio;application/x-arj;application/x-lha;application/x-lzh-compressed;application/x-xar;application/x-apple-diskimage;application/vnd.squashfs;application/x-squashfs;application/vnd.efi.img;application/x-raw-disk-image;application/x-vhd-disk;application/x-vhdx-disk;application/x-vmdk-disk;application/x-qemu-disk;application/x-vdi-disk;application/x-virtualbox-vdi;application/x-msi;application/vnd.ms-htmlhelp;application/x-archive;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=7zipl
